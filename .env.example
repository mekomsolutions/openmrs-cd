# Copy to '.env' and keep one of the blocks below. Leave VAULT_ADDR empty to disable Vault.

# --- Bundled dev Vault (docker compose --profile vault up) ---
VAULT_ADDR=http://vault:8200
VAULT_AUTH_METHOD=token
VAULT_TOKEN=root

# --- External Vault with AppRole ---
# VAULT_ADDR=https://vault.example.com
# VAULT_AUTH_METHOD=approle
# VAULT_ROLE_ID=
# VAULT_SECRET_ID=
# VAULT_APPROLE_PATH=approle
# VAULT_NAMESPACE=

# --- External Vault with Kubernetes auth (OCD3 running in a pod) ---
# VAULT_ADDR=https://vault.example.com
# VAULT_AUTH_METHOD=kubernetes
# VAULT_K8S_ROLE=ocd3
# VAULT_K8S_MOUNT=kubernetes

# KV secrets engine version (1 or 2) and TLS verification
# VAULT_KV_VERSION=2
# VAULT_SKIP_VERIFY=false
